{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "env": ["TOKENROUTER_API_KEY", "TOKENROUTER_BASE_URL"],
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k3-free": {
          "name": "Kimi K3 Free"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "ask"
    }
  }
}
